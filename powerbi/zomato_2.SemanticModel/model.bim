        "lineageTag": "c89eb3a7-d88b-4e07-be34-b44491923608",
        "measures": [
          {
            "name": "Total Orders",
            "expression": "COUNTROWS('cleaned_zomato_data')",
            "formatString": "#,0",
            "lineageTag": "c8a15abc-b41e-4cf4-8304-531d33170edb"
          },
          {
            "name": "Avg Delivery Time (min)",
            "expression": "AVERAGE('cleaned_zomato_data'[Time_taken_min])",
            "formatString": "0.00",
            "lineageTag": "d7aa9328-00e9-4db4-88d7-7156463211a9"
          },
          {
            "name": "Median Delivery Time (min)",
            "expression": "MEDIAN('cleaned_zomato_data'[Time_taken_min])",
            "formatString": "0.0",
            "lineageTag": "f05c85ad-692a-42d6-9b15-4df7db871876"
          },
          {
            "name": "Avg Distance (km)",
            "expression": "AVERAGE('cleaned_zomato_data'[delivery_distance_km])",
            "formatString": "0.00",
            "lineageTag": "0ca150dd-e385-492c-a4bc-5ee7f82035fa"
          },
          {
            "name": "Avg Prep Time (min)",
            "expression": "AVERAGE('cleaned_zomato_data'[prep_time_min])",
            "formatString": "0.00",
            "lineageTag": "2eedbc4f-b2b0-4c48-a659-5a2344260690"
          },
          {
            "name": "Avg Partner Rating",
            "expression": "AVERAGE('cleaned_zomato_data'[Delivery_person_Ratings])",
            "formatString": "0.00",
            "lineageTag": "42c9f104-f169-47e2-9aec-edc1286a2c78"
          },
          {
            "name": "Avg Partner Age",
            "expression": "AVERAGE('cleaned_zomato_data'[Delivery_person_Age])",
            "formatString": "0.0",
            "lineageTag": "29005f8a-7681-42b5-9101-08f7a9ca5604"
          },
          {
            "name": "Order Share %",
            "expression": "DIVIDE(COUNTROWS('cleaned_zomato_data'), CALCULATE(COUNTROWS('cleaned_zomato_data'), ALL('cleaned_zomato_data')), 0)",
            "formatString": "0.0%",
            "lineageTag": "19876680-3b53-41e5-9092-3e79042fd077"
          }
        ],
