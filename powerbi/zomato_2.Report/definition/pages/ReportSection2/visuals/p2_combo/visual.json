          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "cleaned_zomato_data"
                    }
                  },
                  "Property": "Total Orders"
                }
              },
              "queryRef": "cleaned_zomato_data.Total Orders"
            }
          ]
